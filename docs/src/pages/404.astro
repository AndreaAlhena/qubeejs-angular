---
// Imported here rather than with @import in the <style> below: Vite resolves
// the font files only for stylesheets imported from script.
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/space-grotesk';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 — no such route</title>
    <link rel="icon" href={`${base}/mark.png`} />
  </head>
  <body>
    <main>
      <img src={`${base}/mark.png`} alt="" width="168" height="113" />
      <p class="code">404 — NO SUCH ROUTE</p>
      <h1>This one didn't paginate</h1>
      <p class="lede">
        The bee flew past the last page. <code>hasNextPage()</code> would have said no.
      </p>
      <div class="cta">
        <a class="btn primary" href={`${base}/`}>Back to firstPage()</a>
        <a class="btn" href={`${base}/guide/getting-started/`}>Read the guide</a>
      </div>
    </main>

    <style is:global>
      :root {
        --honey: #dd0031;
        --honey-hi: #f4123f;
        --ink: #ff6a80;
        --alt: #101216;
        --border: #2b3038;
        --text: #e9eaee;
        --muted: #98a0ac;
      }

      * { box-sizing: border-box; }

      body {
        align-items: center;
        background: var(--alt);
        color: var(--text);
        display: flex;
        font-family: 'IBM Plex Sans Variable', system-ui, sans-serif;
        justify-content: center;
        margin: 0;
        min-height: 100vh;
        padding: 60px 22px;
        text-align: center;
      }

      main { max-width: 520px; }

      img {
        animation: qb-bob 5s ease-in-out infinite;
        filter: drop-shadow(0 18px 34px rgba(221, 0, 49, 0.26));
        height: auto;
        margin-bottom: 26px;
      }

      @keyframes qb-bob {
        0%, 100% { transform: translateY(0) rotate(-2deg); }
        50% { transform: translateY(-7px) rotate(2deg); }
      }

      @media (prefers-reduced-motion: reduce) {
        img { animation: none; }
      }

      .code {
        color: var(--ink);
        font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
        font-size: 13px;
        letter-spacing: 0.22em;
        margin: 0 0 14px;
      }

      h1 {
        font-family: 'Space Grotesk Variable', system-ui, sans-serif;
        font-size: clamp(30px, 6vw, 38px);
        letter-spacing: -0.03em;
        line-height: 1.1;
        margin: 0 0 14px;
      }

      .lede {
        color: var(--muted);
        font-size: 16.5px;
        line-height: 1.6;
        margin: 0 0 30px;
      }

      .lede code {
        color: var(--text);
        font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
        font-size: 14px;
      }

      .cta { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }

      .btn {
        border: 1px solid var(--border);
        border-radius: 9px;
        color: inherit;
        font-size: 14.5px;
        font-weight: 600;
        padding: 11px 20px;
        text-decoration: none;
      }

      .btn:hover { border-color: var(--honey); }

      .btn.primary {
        background: var(--honey);
        border-color: var(--honey);
        color: #ffffff;
      }

      .btn.primary:hover { background: var(--honey-hi); }
    </style>
  </body>
</html>
